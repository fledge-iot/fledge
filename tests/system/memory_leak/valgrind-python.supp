# General Python suppressions for multiple versions
{
   Python _PyObject_New possibly lost
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   fun:_PyObject_New
}

{
   Python initialization still reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:Py_InitializeFromConfig
}

{
   Python wide string copy still reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   fun:_PyWideStringList_Copy
}

{
   Python PyMem_Malloc possibly lost
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   fun:PyMem_Malloc
}

{
   Python PyMem_RawMalloc possibly lost  
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   fun:PyMem_RawMalloc
}

